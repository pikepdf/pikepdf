{
  "$comment": "Per-role shallow schemas for the pikepdf PDF/A validator. Instances are qpdf-JSON-v2-style shallow encodings: names '/X', strings 'u:text' or 'b:hex', indirect references 'N G R'. Annotations: x-verapdf lists veraPDF rule ids (the one matching the flavour is reported); x-unsupported marks constructs the validator does not check (reported as unsupported, not as violations); x-message overrides the error text; x-kind is the pikepdf object kind the role expects (dict, stream, array, any; default dict); x-children maps keys to child roles ('*' = every element or value; {'role': R, 'each': true} = every element of an array value, or the value itself otherwise; 'values': true = with 'each', every value of a dictionary value (a map such as a resource category); 'sibling': true = does not count toward the depth limit); x-dispatch selects a more specific role by the value of a key; x-closed: true on a node with additionalProperties or unevaluatedProperties false marks a dictionary whose unlisted keys PDF/A itself forbids (reported as violations with the node's x-verapdf id). Without x-closed, an unlisted key is reported as unsupported, since PDF permits private and future keys and the validator cannot know what they mean.",
  "$defs": {
    "ref": {"type": "string", "pattern": "^[0-9]+ [0-9]+ R$"},
    "name": {"type": "string", "pattern": "^/"},
    "text": {"type": "string", "pattern": "^[ub]:"},
    "number": {"type": "number"},
    "integer": {"type": "integer"},
    "boolean": {"type": "boolean"},
    "dictOrRef": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "object"}]},
    "arrayOrRef": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "array"}]},
    "refArray": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "rect": {
      "anyOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      ]
    },
    "destination": {
      "$comment": "Explicit destination array, or a named destination",
      "anyOf": [{"type": "array"}, {"$ref": "#/$defs/name"}, {"$ref": "#/$defs/text"}]
    },
    "forbidden": {"not": {}},
    "colourSpace": {
      "$comment": "A colour space family name or array; _colour.resolve_colourspace checks it",
      "anyOf": [{"$ref": "#/$defs/name"}, {"type": "array"}, {"$ref": "#/$defs/ref"}]
    },
    "renderingIntent": {
      "enum": ["/RelativeColorimetric", "/AbsoluteColorimetric", "/Perceptual", "/Saturation"],
      "x-verapdf": ["ISO_19005_1:6.2.9-1", "ISO_19005_2:6.2.6-1", "ISO_19005_3:6.2.6-1"]
    },
    "blendModeName": {
      "enum": [
        "/Normal", "/Compatible", "/Multiply", "/Screen", "/Overlay", "/Darken", "/Lighten",
        "/ColorDodge", "/ColorBurn", "/HardLight", "/SoftLight", "/Difference", "/Exclusion",
        "/Hue", "/Saturation", "/Color", "/Luminosity"
      ],
      "x-verapdf": ["ISO_19005_2:6.2.10-1", "ISO_19005_3:6.2.10-1"]
    },
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "procSet": {
      "anyOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "array", "items": {"enum": ["/PDF", "/Text", "/ImageB", "/ImageC", "/ImageI"]}}
      ]
    },
    "obsoleteProcSet": {
      "$comment": "/ProcSet outside a resource dictionary is an obsolete PDF 1.x key that readers ignore; PDF/A does not restrict it",
      "$ref": "#/$defs/procSet"
    },
    "unsupported": {"not": {}, "x-unsupported": true},
    "filterName": {
      "enum": [
        "/ASCIIHexDecode", "/ASCII85Decode", "/FlateDecode", "/RunLengthDecode",
        "/CCITTFaxDecode", "/JBIG2Decode", "/DCTDecode", "/JPXDecode"
      ]
    },
    "filter": {
      "$comment": "LZWDecode and Crypt are not permitted; anything else unknown is denied too",
      "x-verapdf": ["ISO_19005_1:6.1.10-1", "ISO_19005_2:6.1.7.2-1", "ISO_19005_3:6.1.7.2-1"],
      "anyOf": [
        {"$ref": "#/$defs/filterName"},
        {"type": "array", "items": {"$ref": "#/$defs/filterName"}}
      ]
    },
    "externalStreamKey": {
      "$comment": "/F, /FFilter and /FDecodeParms (external stream data) are not permitted",
      "$ref": "#/$defs/forbidden",
      "x-verapdf": ["ISO_19005_1:6.1.7-3", "ISO_19005_2:6.1.7.1-3", "ISO_19005_3:6.1.7.1-3"]
    },

    "Trailer": {
      "type": "object",
      "allOf": [
        {"required": ["/ID"], "x-verapdf": ["ISO_19005_1:6.1.3-1", "ISO_19005_2:6.1.3-1", "ISO_19005_3:6.1.3-1"]},
        {"required": ["/Root"]}
      ],
      "properties": {
        "/Root": {"$ref": "#/$defs/ref"},
        "/Info": {"$ref": "#/$defs/ref"},
        "/ID": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/text"},
          "x-verapdf": ["ISO_19005_1:6.1.3-1", "ISO_19005_2:6.1.3-1", "ISO_19005_3:6.1.3-1"]
        },
        "/Size": {"$ref": "#/$defs/integer"},
        "/Prev": {"$ref": "#/$defs/integer"},
        "/Encrypt": {"$ref": "#/$defs/forbidden", "x-verapdf": ["ISO_19005_1:6.1.3-2", "ISO_19005_2:6.1.3-2", "ISO_19005_3:6.1.3-2"]},
        "/Type": {"const": "/XRef"},
        "/W": {"type": "array"},
        "/Index": {"type": "array"},
        "/Filter": {"$ref": "#/$defs/filter"},
        "/DecodeParms": {"anyOf": [{"type": "object"}, {"type": "array"}]},
        "/Length": {"$ref": "#/$defs/integer"}
      },
      "additionalProperties": false,
      "x-children": {"/Root": "Catalog", "/Info": "Info"}
    },

    "Info": {
      "type": "object",
      "properties": {
        "/Title": {"$ref": "#/$defs/text"},
        "/Author": {"$ref": "#/$defs/text"},
        "/Subject": {"$ref": "#/$defs/text"},
        "/Keywords": {"$ref": "#/$defs/text"},
        "/Creator": {"$ref": "#/$defs/text"},
        "/Producer": {"$ref": "#/$defs/text"},
        "/CreationDate": {"$ref": "#/$defs/text"},
        "/ModDate": {"$ref": "#/$defs/text"},
        "/Trapped": {"enum": ["/True", "/False", "/Unknown"]}
      },
      "additionalProperties": {
        "$comment": "Custom document information entries (e.g. Apple's /AAPL:Keywords array) do not affect rendering",
        "anyOf": [
          {"$ref": "#/$defs/text"},
          {"$ref": "#/$defs/name"},
          {"$ref": "#/$defs/ref"},
          {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/ref"}]}}
        ]
      }
    },

    "Catalog": {
      "type": "object",
      "required": ["/Type", "/Pages"],
      "properties": {
        "/Type": {"const": "/Catalog"},
        "/Pages": {"$ref": "#/$defs/ref"},
        "/Metadata": {"$ref": "#/$defs/ref"},
        "/OutputIntents": {"$ref": "#/$defs/arrayOrRef"},
        "/Version": {
          "type": "string", "pattern": "^/1\\.[0-7]$",
          "x-verapdf": ["ISO_19005_2:6.1.2-1", "ISO_19005_3:6.1.2-1"]
        },
        "/Lang": {"$ref": "#/$defs/text"},
        "/MarkInfo": {"$ref": "#/$defs/dictOrRef"},
        "/StructTreeRoot": {"$ref": "#/$defs/dictOrRef"},
        "/PageMode": {"enum": ["/UseNone", "/UseOutlines", "/UseThumbs", "/FullScreen"]},
        "/PageLayout": {
          "enum": ["/SinglePage", "/OneColumn", "/TwoColumnLeft", "/TwoColumnRight", "/TwoPageLeft", "/TwoPageRight"]
        },
        "/ViewerPreferences": {"$ref": "#/$defs/dictOrRef"},
        "/Outlines": {"$ref": "#/$defs/dictOrRef"},
        "/PageLabels": {"$ref": "#/$defs/dictOrRef"},
        "/AA": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_1:6.6.2-3", "ISO_19005_2:6.5.2-1", "ISO_19005_3:6.5.2-1"],
          "x-message": "the catalog shall not contain additional actions (/AA)"
        },
        "/OCProperties": {
          "$ref": "#/$defs/unsupported",
          "x-verapdf": ["ISO_19005_1:6.1.13-1"],
          "x-message": "optional content (/OCProperties) is not supported"
        },
        "/Requirements": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_2:6.11-1", "ISO_19005_3:6.11-1"]
        },
        "/NeedsRendering": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_2:6.4.2-2", "ISO_19005_3:6.4.2-2"]
        },
        "/AcroForm": {"$ref": "#/$defs/unsupported", "x-message": "interactive forms (/AcroForm) are not supported"},
        "/Names": {"$ref": "#/$defs/unsupported", "x-message": "the name dictionary (/Names) is not supported"},
        "/Dests": {"$ref": "#/$defs/unsupported", "x-message": "named destinations (/Dests) are not supported"},
        "/Perms": {"$ref": "#/$defs/unsupported", "x-message": "permissions (/Perms) are not supported"},
        "/Collection": {"$ref": "#/$defs/unsupported", "x-message": "portable collections are not supported"},
        "/OpenAction": {"$ref": "#/$defs/unsupported", "x-message": "/OpenAction is not supported"},
        "/AF": {"$ref": "#/$defs/unsupported", "x-message": "associated files (/AF) are not supported"},
        "/Extensions": {"$ref": "#/$defs/unsupported", "x-message": "developer extensions are not supported"}
      },
      "additionalProperties": false,
      "x-children": {
        "/OutputIntents": "OutputIntents",
        "/Metadata": "MetadataStream",
        "/Pages": "Pages",
        "/MarkInfo": "MarkInfo",
        "/ViewerPreferences": "ViewerPreferences",
        "/Outlines": "Outlines",
        "/PageLabels": "PageLabelsNode",
        "/StructTreeRoot": "StructTreeRoot"
      }
    },

    "OutputIntents": {
      "x-kind": "array",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dictOrRef"},
      "x-children": {"*": "OutputIntent"}
    },

    "OutputIntent": {
      "type": "object",
      "required": ["/S", "/DestOutputProfile"],
      "properties": {
        "/Type": {"const": "/OutputIntent"},
        "/S": {
          "const": "/GTS_PDFA1",
          "x-unsupported": true,
          "x-message": "only GTS_PDFA1 output intents are supported"
        },
        "/OutputCondition": {"$ref": "#/$defs/text"},
        "/OutputConditionIdentifier": {"$ref": "#/$defs/text"},
        "/RegistryName": {"$ref": "#/$defs/text"},
        "/Info": {"$ref": "#/$defs/text"},
        "/DestOutputProfile": {"$ref": "#/$defs/ref"},
        "/DestOutputProfileRef": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_2:6.2.3-3", "ISO_19005_3:6.2.3-3"]
        }
      },
      "additionalProperties": false,
      "x-children": {"/DestOutputProfile": "ICCOutputProfile"}
    },

    "ICCOutputProfile": {
      "x-kind": "stream",
      "type": "object",
      "required": ["/N"],
      "properties": {
        "/F": {"$ref": "#/$defs/externalStreamKey"},
        "/FFilter": {"$ref": "#/$defs/externalStreamKey"},
        "/FDecodeParms": {"$ref": "#/$defs/externalStreamKey"},
        "/N": {"enum": [1, 3, 4]},
        "/Alternate": {"enum": ["/DeviceGray", "/DeviceRGB", "/DeviceCMYK"]},
        "/Range": {"type": "array", "items": {"type": "number"}},
        "/Length": {"$ref": "#/$defs/integer"},
        "/Filter": {"$ref": "#/$defs/filter"},
        "/DecodeParms": {"anyOf": [{"type": "object"}, {"type": "array"}]},
        "/Metadata": {"$ref": "#/$defs/unsupported"}
      },
      "additionalProperties": false
    },

    "MetadataStream": {
      "x-kind": "stream",
      "type": "object",
      "allOf": [
        {
          "required": ["/Type", "/Subtype"],
          "properties": {"/Type": {"const": "/Metadata"}, "/Subtype": {"const": "/XML"}},
          "x-verapdf": ["ISO_19005_1:6.7.2-1", "ISO_19005_2:6.6.2.1-1", "ISO_19005_3:6.6.2.1-1"]
        }
      ],
      "properties": {
        "/F": {"$ref": "#/$defs/externalStreamKey"},
        "/FFilter": {"$ref": "#/$defs/externalStreamKey"},
        "/FDecodeParms": {"$ref": "#/$defs/externalStreamKey"},
        "/Type": true,
        "/Subtype": true,
        "/Length": {"$ref": "#/$defs/integer"},
        "/Filter": {"$ref": "#/$defs/filter"},
        "/DecodeParms": {"anyOf": [{"type": "object"}, {"type": "array"}]}
      },
      "additionalProperties": false
    },

    "Pages": {
      "type": "object",
      "required": ["/Type", "/Kids"],
      "properties": {
        "/Type": {"const": "/Pages"},
        "/Kids": {"$ref": "#/$defs/refArray"},
        "/Count": {"$ref": "#/$defs/integer"},
        "/Parent": {"$ref": "#/$defs/ref"},
        "/Resources": {"$ref": "#/$defs/dictOrRef"},
        "/MediaBox": {"$ref": "#/$defs/rect"},
        "/CropBox": {"$ref": "#/$defs/rect"},
        "/Rotate": {"type": "integer", "multipleOf": 90},
        "/ProcSet": {"$ref": "#/$defs/obsoleteProcSet"}
      },
      "additionalProperties": false,
      "x-children": {
        "/Resources": "Resources",
        "/Kids": {"role": "PageTreeNode", "each": true}
      }
    },

    "PageTreeNode": {
      "type": "object",
      "required": ["/Type"],
      "properties": {"/Type": {"enum": ["/Pages", "/Page"]}},
      "x-dispatch": {"key": "/Type", "roles": {"/Pages": "Pages", "/Page": "Page"}}
    },

    "Page": {
      "type": "object",
      "required": ["/Type", "/Parent"],
      "properties": {
        "/Type": {"const": "/Page"},
        "/Parent": {"$ref": "#/$defs/ref"},
        "/Contents": {"anyOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/refArray"}]},
        "/Resources": {"$ref": "#/$defs/dictOrRef"},
        "/MediaBox": {"$ref": "#/$defs/rect"},
        "/CropBox": {"$ref": "#/$defs/rect"},
        "/BleedBox": {"$ref": "#/$defs/rect"},
        "/TrimBox": {"$ref": "#/$defs/rect"},
        "/ArtBox": {"$ref": "#/$defs/rect"},
        "/Rotate": {"type": "integer", "multipleOf": 90},
        "/Annots": {"$ref": "#/$defs/arrayOrRef"},
        "/Group": {"$ref": "#/$defs/dictOrRef"},
        "/Metadata": {"$ref": "#/$defs/ref"},
        "/UserUnit": {"$ref": "#/$defs/number"},
        "/StructParents": {"$ref": "#/$defs/integer"},
        "/Tabs": {"enum": ["/R", "/C", "/S"]},
        "/LastModified": {"$ref": "#/$defs/text"},
        "/ProcSet": {"$ref": "#/$defs/obsoleteProcSet"},
        "/AA": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_2:6.5.2-2", "ISO_19005_3:6.5.2-2"],
          "x-message": "a page shall not contain additional actions (/AA)"
        },
        "/PresSteps": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_2:6.10-2", "ISO_19005_3:6.10-2"]
        },
        "/PieceInfo": {"$ref": "#/$defs/unsupported"}
      },
      "additionalProperties": false,
      "x-children": {
        "/Resources": "Resources",
        "/Group": "TransparencyGroup",
        "/Contents": {"role": "ContentStream", "each": true},
        "/Annots": {"role": "Annot", "each": true},
        "/Metadata": "ObjectMetadata"
      }
    },

    "TransparencyGroup": {
      "type": "object",
      "required": ["/S"],
      "properties": {
        "/Type": {"const": "/Group"},
        "/S": {"const": "/Transparency"},
        "/CS": {"$ref": "#/$defs/colourSpace"},
        "/I": {"$ref": "#/$defs/boolean"},
        "/K": {"$ref": "#/$defs/boolean"}
      },
      "additionalProperties": false
    },

    "ContentStream": {
      "x-kind": "stream",
      "type": "object",
      "properties": {
        "/F": {"$ref": "#/$defs/externalStreamKey"},
        "/FFilter": {"$ref": "#/$defs/externalStreamKey"},
        "/FDecodeParms": {"$ref": "#/$defs/externalStreamKey"},
        "/Length": {"$ref": "#/$defs/integer"},
        "/Filter": {"$ref": "#/$defs/filter"},
        "/DecodeParms": {"anyOf": [{"type": "object"}, {"type": "array"}]}
      },
      "additionalProperties": false
    },

    "Resources": {
      "type": "object",
      "properties": {
        "/Font": {"$ref": "#/$defs/dictOrRef"},
        "/XObject": {"$ref": "#/$defs/dictOrRef"},
        "/ExtGState": {"$ref": "#/$defs/dictOrRef"},
        "/ColorSpace": {"$ref": "#/$defs/dictOrRef"},
        "/Properties": {"$ref": "#/$defs/dictOrRef"},
        "/ProcSet": {"$ref": "#/$defs/procSet"},
        "/Pattern": {"$ref": "#/$defs/unsupported", "x-message": "patterns are not supported"},
        "/Shading": {"$ref": "#/$defs/unsupported", "x-message": "shadings are not supported"}
      },
      "additionalProperties": false,
      "x-children": {
        "/Font": {"role": "Font", "each": true, "values": true},
        "/XObject": {"role": "XObject", "each": true, "values": true},
        "/ExtGState": {"role": "ExtGState", "each": true, "values": true},
        "/ColorSpace": {"role": "ColorSpace", "each": true, "values": true},
        "/Properties": {"role": "Properties", "each": true, "values": true}
      }
    },

    "XObject": {
      "x-kind": "stream",
      "type": "object",
      "required": ["/Subtype"],
      "properties": {
        "/Subtype": {
          "enum": ["/Image", "/Form"],
          "x-verapdf": ["ISO_19005_1:6.2.7-1", "ISO_19005_2:6.2.9-3", "ISO_19005_3:6.2.9-3"],
          "x-message": "only Image and Form XObjects are permitted"
        }
      },
      "x-dispatch": {"key": "/Subtype", "roles": {"/Image": "ImageXObject", "/Form": "FormXObject"}}
    },

    "ImageXObject": {
      "x-kind": "stream",
      "type": "object",
      "required": ["/Subtype", "/Width", "/Height"],
      "allOf": [
        {
          "if": {"required": ["/ImageMask"], "properties": {"/ImageMask": {"const": true}}},
          "then": {
            "properties": {"/BitsPerComponent": {"const": 1}},
            "x-verapdf": ["ISO_19005_1:6.2.4-5", "ISO_19005_2:6.2.8-5", "ISO_19005_3:6.2.8-5"]
          }
        }
      ],
      "properties": {
        "/F": {"$ref": "#/$defs/externalStreamKey"},
        "/FFilter": {"$ref": "#/$defs/externalStreamKey"},
        "/FDecodeParms": {"$ref": "#/$defs/externalStreamKey"},
        "/Type": {"const": "/XObject"},
        "/Subtype": {"const": "/Image"},
        "/Width": {"type": "integer", "minimum": 1},
        "/Height": {"type": "integer", "minimum": 1},
        "/ColorSpace": {"$ref": "#/$defs/colourSpace"},
        "/BitsPerComponent": {
          "enum": [1, 2, 4, 8, 16],
          "x-verapdf": ["ISO_19005_2:6.2.8-4", "ISO_19005_3:6.2.8-4"]
        },
        "/ImageMask": {"$ref": "#/$defs/boolean"},
        "/Mask": {
          "anyOf": [{"$ref": "#/$defs/ref"}, {"type": "array", "items": {"$ref": "#/$defs/integer"}}],
          "x-message": "/Mask shall be a stencil mask image or a colour key array"
        },
        "/Decode": {"type": "array", "items": {"type": "number"}},
        "/Matte": {"type": "array", "items": {"type": "number"}},
        "/Interpolate": {
          "const": false,
          "x-verapdf": ["ISO_19005_1:6.2.4-3", "ISO_19005_2:6.2.8-3", "ISO_19005_3:6.2.8-3"],
          "x-message": "/Interpolate shall be false"
        },
        "/SMask": {"$ref": "#/$defs/ref"},
        "/Intent": {
          "enum": ["/RelativeColorimetric", "/AbsoluteColorimetric", "/Perceptual", "/Saturation"],
          "x-verapdf": ["ISO_19005_1:6.2.9-1", "ISO_19005_2:6.2.6-1", "ISO_19005_3:6.2.6-1"]
        },
        "/Name": {"$ref": "#/$defs/name"},
        "/StructParent": {"$ref": "#/$defs/integer"},
        "/ID": {"$ref": "#/$defs/text"},
        "/Length": {"$ref": "#/$defs/integer"},
        "/Filter": {
          "allOf": [
            {"$ref": "#/$defs/filter"},
            {
              "not": {"anyOf": [{"const": "/JPXDecode"}, {"type": "array", "contains": {"const": "/JPXDecode"}}]},
              "x-unsupported": true,
              "x-message": "JPEG 2000 images are not supported"
            }
          ]
        },
        "/DecodeParms": {"anyOf": [{"type": "object"}, {"type": "array"}]},
        "/Alternates": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_1:6.2.4-1", "ISO_19005_2:6.2.8-1", "ISO_19005_3:6.2.8-1"]
        },
        "/OPI": {
          "$ref": "#/$defs/forbidden",
          "x-verapdf": ["ISO_19005_1:6.2.4-2", "ISO_19005_2:6.2.8-2", "ISO_19005_3:6.2.8-2"]
        },
        "/OC": {"$ref": "#/$defs/unsupported", "x-message": "optional content is not supported"},
        "/Metadata": {"$ref": "#/$defs/unsupported", "x-message": "image metadata streams are not supported"},
        "/SMaskInData": {"$ref": "#/$defs/unsupported"}
      },
      "additionalProperties": false,
      "x-children": {"/SMask": "SMaskImage"}
    },

    "MaskImage": {
      "x-kind": "stream",
      "allOf": [
        {"$ref": "#/$defs/ImageXObject"},
        {
          "required": ["/ImageMask"],
          "properties": {"/ImageMask": {"const": true}, "/ColorSpace": false, "/Mask": false, "/SMask": false}
        }
      ]
    },

    "SMaskImage": {
      "x-kind": "stream",
      "allOf": [
        {"$ref": "#/$defs/ImageXObject"},
        {
          "required": ["/ColorSpace"],
          "properties": {"/ColorSpace": {"const": "/DeviceGray"}, "/Mask": false, "/SMask": false, "/ImageMask": false}
        }
      ]
    },

    "Outlines": {
      "type": "object",
      "properties": {
        "/Type": {"const": "/Outlines"},
        "/First": {"$ref": "#/$defs/ref"},
        "/Last": {"$ref": "#/$defs/ref"},
        "/Count": {"$ref": "#/$defs/integer"}
      },
      "additionalProperties": false,
      "x-children": {"/First": "OutlineItem"}
    },

    "OutlineItem": {
      "type": "object",
      "required": ["/Title"],
      "properties": {
        "/Title": {"$ref": "#/$defs/text"},
        "/Parent": {"$ref": "#/$defs/ref"},
        "/Prev": {"$ref": "#/$defs/ref"},
        "/Next": {"$ref": "#/$defs/ref"},
        "/First": {"$ref": "#/$defs/ref"},
        "/Last": {"$ref": "#/$defs/ref"},
        "/Count": {"$ref": "#/$defs/integer"},
        "/Dest": {"$ref": "#/$defs/destination"},
        "/A": {"$ref": "#/$defs/dictOrRef"},
        "/C": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "/F": {"$ref": "#/$defs/integer"},
        "/SE": {"$ref": "#/$defs/unsupported"}
      },
      "additionalProperties": false,
      "x-children": {
        "/First": "OutlineItem",
        "/Next": {"role": "OutlineItem", "sibling": true},
        "/A": "Action"
      }
    },

    "Action": {
      "type": "object",
      "required": ["/S"],
      "allOf": [
        {
          "if": {"required": ["/S"], "properties": {"/S": {"const": "/Named"}}},
