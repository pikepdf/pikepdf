{
  "$comment": "PDF/A-3b (ISO 19005-3, based on PDF 1.7) additions to common.json. common.json already describes the most permissive (PDF/A-2 and -3) shapes, so roles not listed here are used unchanged, except for embedded and associated files, which only PDF/A-3 permits.",
  "$defs": {
    "Catalog": {
      "allOf": [{"$ref": "common.json#/$defs/Catalog"}]
    },

    "EmbeddedFiles": {
      "$comment": "A node of the embedded files name tree (ISO 32000-1 7.9.6); _walker.DocumentWalker._on_embedded_files checks the /Names pairs and follows each value as a FileSpec",
      "type": "object",
      "properties": {
        "/Names": {
          "anyOf": [
            {"$ref": "common.json#/$defs/ref"},
            {"type": "array", "items": {"anyOf": [{"$ref": "common.json#/$defs/text"}, {"type": "object"}, {"$ref": "common.json#/$defs/ref"}]}}
          ]
        },
        "/Kids": {"$ref": "common.json#/$defs/refArray"},
        "/Limits": {"type": "array", "items": {"$ref": "common.json#/$defs/text"}, "minItems": 2, "maxItems": 2}
      },
      "additionalProperties": false,
      "x-children": {"/Kids": {"role": "EmbeddedFiles", "each": true}}
    },

    "AssociatedFiles": {
      "$comment": "The catalog /AF array (ISO 19005-3 6.8, ISO 32000-2 14.13)",
      "x-kind": "array",
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/ref",
        "x-unsupported": true,
        "x-message": "direct file specifications in /AF are not supported"
      },
      "x-children": {"*": "FileSpec"}
    },

    "FileSpec": {
      "$comment": "A file specification dictionary of an embedded file (ISO 32000-1 Table 44, ISO 19005-3 6.8). References to external files are not supported",
      "type": "object",
      "allOf": [
        {
          "required": ["/EF"],
          "x-unsupported": true,
          "x-message": "file specifications of external files (without /EF) are not supported"
        },
        {
          "if": {"required": ["/EF"]},
          "then": {"required": ["/Type"]},
          "x-message": "a file specification with /EF shall have /Type /Filespec"
        },
        {
          "if": {"required": ["/EF"]},
          "then": {"required": ["/F", "/UF"]},
          "x-verapdf": ["ISO_19005_3:6.8-2"],
          "x-message": "the file specification of an embedded file shall contain /F and /UF"
        },
        {
          "required": ["/AFRelationship"],
          "x-verapdf": ["ISO_19005_3:6.8-3"],
          "x-message": "the file specification shall contain /AFRelationship"
        }
      ],
      "properties": {
        "/Type": {"const": "/Filespec"},
        "/F": {"$ref": "common.json#/$defs/text"},
        "/UF": {"$ref": "common.json#/$defs/text"},
        "/Desc": {"$ref": "common.json#/$defs/text"},
        "/EF": {"$ref": "common.json#/$defs/dictOrRef"},
        "/AFRelationship": {
          "allOf": [
            {
              "$ref": "common.json#/$defs/name",
              "x-verapdf": ["ISO_19005_3:6.8-3"],
              "x-message": "/AFRelationship shall be a name"
            },
            {
              "enum": ["/Source", "/Data", "/Alternative", "/Supplement", "/Unspecified"],
              "x-unsupported": true,
              "x-message": "/AFRelationship values other than those of ISO 19005-3 are not supported"
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-children": {"/EF": "FileSpecEF"}
    },

    "FileSpecEF": {
      "$comment": "The /EF dictionary of a file specification",
      "type": "object",
      "allOf": [
        {"required": ["/F"], "x-unsupported": true, "x-message": "an /EF dictionary without /F is not supported"}
      ],
      "properties": {
        "/F": {"$ref": "common.json#/$defs/ref"},
        "/UF": {"$ref": "common.json#/$defs/ref"}
      },
      "additionalProperties": false,
      "x-children": {"/F": "EmbeddedFile", "/UF": "EmbeddedFile"}
    },

    "EmbeddedFile": {
      "$comment": "An embedded file stream (ISO 32000-1 Table 45). The MIME type pattern is veraPDF's, which ISO 19005-3 6.8-1 checks against the name without its slash",
      "x-kind": "stream",
      "type": "object",
      "allOf": [
        {"$ref": "common.json#/$defs/streamKeys"},
        {
          "required": ["/Subtype"],
          "x-verapdf": ["ISO_19005_3:6.8-1"],
          "x-message": "the embedded file has no MIME type (/Subtype)"
        }
      ],
      "properties": {
        "/F": true, "/FFilter": true, "/FDecodeParms": true, "/Length": true,
        "/Filter": true, "/DecodeParms": true, "/DL": true,
        "/Type": {"const": "/EmbeddedFile"},
        "/Subtype": {
          "type": "string",
          "pattern": "^/[-A-Za-z0-9_+.]+/[-A-Za-z0-9_+.]+$(?!\\n)",
          "x-verapdf": ["ISO_19005_3:6.8-1"],
          "x-message": "the embedded file's /Subtype is not a MIME type"
        },
        "/Params": {"$ref": "common.json#/$defs/dictOrRef"}
      },
      "additionalProperties": false,
      "x-children": {"/Params": "EmbeddedFileParams"}
    },

    "EmbeddedFileParams": {
      "$comment": "ISO 32000-1 Table 46",
      "type": "object",
      "properties": {
        "/Size": {"$ref": "common.json#/$defs/integer"},
        "/CreationDate": {"$ref": "common.json#/$defs/text"},
        "/ModDate": {"$ref": "common.json#/$defs/text"},
        "/CheckSum": {"$ref": "common.json#/$defs/text"},
        "/Mac": {"$ref": "common.json#/$defs/unsupported", "x-message": "Mac OS file information is not supported"}
      },
      "additionalProperties": false
    }
  }
}
